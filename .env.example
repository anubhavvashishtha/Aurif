BASETEN_API_KEY=
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Models (optional to boot; needed for live Muse / CAPTCHA vision) ---
# Meta Model API — text defaults to muse-spark-1.3
META_API_KEY=
# MODEL_API_KEY=

# Draw-CAPTCHA vision on Meta (demo uses Wonder)
META_VISION_MODEL=muse-wonder-1.0

# Or Baseten only (text + vision when no Meta key)
# BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional switches — see docs/MODELS.md
# LLM_PROVIDER=meta
# LLM_FALLBACK_PROVIDER=baseten
# VISION_PROVIDER=meta
# VISION_FALLBACK_PROVIDER=baseten

# --- Local process (defaults match README) ---
# HOST=127.0.0.1
# PORT=8787
# FLASK_DEBUG=0
# AURIF_API_PUBLIC_URL=http://127.0.0.1:8787
# CUSTOMER_SITE_URL=http://127.0.0.1:5173
# DASHBOARD_URL=http://127.0.0.1:5174
# AURIF_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
# AURIF_SITE_KEY=
# AURIF_STORE_PATH=
