# Meta Model API key. Set one of these (META_API_KEY wins if both are set).
# Create the key in the Meta Model API console. Do not commit the real value.
MODEL_API_KEY=
# META_API_KEY=

# Optional. Defaults: provider meta, base https://api.meta.ai/v1, model muse-spark-1.3.
# META_PROVIDER=meta
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_REASONING_EFFORT=low

# Optional vision overrides. Unset means vision uses the text endpoint above.
# Muse Spark 1.3 accepts image data URLs, so a second host is not required.
# META_VISION_PROVIDER=meta
# META_VISION_BASE_URL=https://api.meta.ai/v1
# META_VISION_MODEL=muse-spark-1.3
# META_VISION_API_KEY=

# Baseten still serves Meta Muse weights if you are not on the Meta Model API.
# Do not point these at DeepSeek. Vision fails closed instead of falling back.
# META_PROVIDER=baseten
# META_BASE_URL=https://inference.baseten.co/v1
# META_MODEL=meta-models/muse-spark-open-1026
# META_API_KEY=
# META_VISION_MODEL=meta-models/muse-spark-open
