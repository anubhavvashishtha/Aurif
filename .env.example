# Text and vision are separate. Do not commit real values.
# Details: docs/MODELS.md.
#
# Text: META_API_KEY / MODEL_API_KEY select Muse Spark 1.3 at https://api.meta.ai/v1.
# If those are unset, BASETEN_API_KEY keeps Muse Spark Open
# (default meta-models/muse-spark-open-1026). A DeepSeek id is refused for text.
#
# Vision (draw-CAPTCHA only): Modal DeepSeek when both MODAL_TOKEN_ID and
# MODAL_TOKEN_SECRET are set. Otherwise VISION_*, then DeepSeek on Baseten.
# META_VISION_* still applies when the matching VISION_* var is unset.

# Meta Model API (text, preferred when you have a key):
# MODEL_API_KEY=
# META_API_KEY=

# Baseten. Text uses this when no Meta key is set. Vision uses it by default.
BASETEN_API_KEY=
# BASETEN_MODEL=meta-models/muse-spark-open-1026

# Optional text overrides.
# META_PROVIDER=meta
# META_BASE_URL=https://api.meta.ai/v1
# META_MODEL=muse-spark-1.3
# META_REASONING_EFFORT=low

# Optional vision overrides. Used only when the Modal tokens below are unset.
# VISION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# VISION_BASE_URL=https://inference.baseten.co/v1
# VISION_API_KEY=
# VISION_PROVIDER=
# META_VISION_PROVIDER=
# META_VISION_BASE_URL=
# META_VISION_MODEL=
# META_VISION_API_KEY=

# Modal vision. Both tokens select Modal over VISION_* and the Baseten default.
# The API key sent to Modal is MODAL_TOKEN_ID.MODAL_TOKEN_SECRET.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
# MODAL_BASE_URL=https://anubhavvashishtha-iitd--ep-deepseek-v4-1-flash-server.us-west.modal.direct/v1
# MODAL_VISION_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# VISION_FALLBACK_MODEL=meta-models/muse-spark-open-1026

# Call budgets. Read timeouts are not retried. META_MAX_RETRIES is extra attempts (0–2).
# META_TIMEOUT_SECONDS=8
# META_VISION_TIMEOUT_SECONDS=15
# VISION_TIMEOUT_SECONDS=
# META_MAX_RETRIES=1

# --- API process. Leave commented for local `python app.py` (127.0.0.1:8787, debugger off). ---
# The process reads this repo-root file (and server/.env if present).
# HOST=127.0.0.1
# PORT=8787
# Debugger is off unless this is 1 or true.
# FLASK_DEBUG=0
# AURIF_ENV=development

# Public origin returned to clients and used when the server calls itself.
# Default is http://127.0.0.1:$PORT.
# AURIF_API_PUBLIC_URL=http://127.0.0.1:8787

# Storefront and dashboard. Also added to the CORS allow-list.
# CUSTOMER_SITE_URL=http://127.0.0.1:5173
# DASHBOARD_URL=http://127.0.0.1:5174

# Extra browser origins, comma-separated. "*" is ignored.
# Localhost :5173 and :5174 are always allowed.
# AURIF_CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174

# Used only when server/data/store.json is created. Delete that file to reseed.
# AURIF_SITE_KEY=

# JSON store path. Default is server/data/store.json.
# AURIF_STORE_PATH=
