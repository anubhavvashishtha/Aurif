# Copy to Demo-client/.env.local for local overrides. Both can stay unset:
# the dev server then uses the defaults below.
# VITE_* values are baked into the browser bundle at build time.
# AURIF_API_URL is read by the storefront server (SSR) at runtime.

# Flask API origin used in the browser (human check).
# VITE_AURIF_API=http://127.0.0.1:8787

# Owner dashboard origin. The storefront embeds /gate from here.
# VITE_AURIF_UI=http://127.0.0.1:5174

# Same API origin for the SSR agent gate. Falls back to VITE_AURIF_API.
# AURIF_API_URL=http://127.0.0.1:8787
