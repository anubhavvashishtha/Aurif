# Copy to Aurif-UI/.env.local for local overrides. Both can stay unset:
# the dev server then uses the defaults below.
# Vite bakes VITE_* into the browser bundle at build time.

# Flask API origin the dashboard calls.
# VITE_AURIF_API=http://127.0.0.1:8787

# "Customer site" link in the dashboard header, and the URL saved when an
# owner signs up and a site row is created.
# VITE_CUSTOMER_SITE_URL=http://127.0.0.1:5173
